{
  "manifest_version": 3,
  "name": "Tab Flash Jump Hints",
  "version": "0.1.0",
  "description": "Home-row letter jump hints for Chrome tabs.",
  "icons": {
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Tab Flash Jump Hints",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["contextMenus", "scripting", "storage", "tabGroups", "tabs"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      }
    },
    "refresh-hints": {
      "description": "Refresh tab jump hint labels"
    },
    "toggle-hints": {
      "description": "Toggle tab jump hint labels"
    }
  }
}

{
  "manifest_version": 3,
  "name": "Tab Flash Jump Hints",
  "version": "0.2.0",
  "description": "Clean-by-default Chrome tab jump labels with popup fallback and a local Ctrl-hold helper.",
  "icons": {
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Tab Flash Jump Hints",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["contextMenus", "tabGroups", "tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      }
    }
  }
}
